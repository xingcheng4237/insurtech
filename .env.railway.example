# Railway Environment Variables Template
# Copy these to Railway Dashboard → Variables → Raw Editor

# Node Environment
NODE_ENV=production
PORT=3000

# Database (auto-configured by Railway MySQL service)
DATABASE_URL=${{MySQL.DATABASE_URL}}

# Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHAR_STRING

# Email Configuration (Gmail SMTP)
EMAIL_USER=xingcheng4237@gmail.com
# Get from: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
EMAIL_FROM=xingcheng4237@gmail.com
EMAIL_TO=xingcheng4237@gmail.com

# AI/LLM API for News Analysis
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY

# Cron Security Token (for scheduled tasks)
# Generate with: openssl rand -base64 32
CRON_SECRET=REPLACE_WITH_RANDOM_32_CHAR_STRING

# Optional: Manus Integration (if using Manus features)
# VITE_APP_ID=your-manus-app-id
# OAUTH_SERVER_URL=https://oauth.manus.im
# OWNER_OPEN_ID=your-manus-open-id
# BUILT_IN_FORGE_API_URL=your-forge-api-url
# BUILT_IN_FORGE_API_KEY=your-forge-api-key
